# ============================================================
# 后端配置模板
# ============================================================
# 用法: 复制本文件为 .env, 然后把下面的占位值换成你自己的。
#     copy .env.example .env
#
# ⚠️ .env 里是你的真实密钥, 不要提交到代码仓库、也不要发给别人。
# ============================================================

# ---------- LLM 配置(必填) ----------
# 兼容 OpenAI 接口的服务都可以: DeepSeek / 通义 / Kimi / ModelScope 等。
# 三项必须互相对应: 模型名要是这个 BASE_URL 下真实存在的模型。
# 下面以 DeepSeek 为例。

# 模型名称
LLM_MODEL_ID=deepseek-chat

# API 密钥
LLM_API_KEY=your-llm-api-key-here

# 服务地址
LLM_BASE_URL=https://api.deepseek.com/v1

# ---------- 高德地图(必填) ----------
# ⚠️ 这里要填【Web 服务】类型的 Key, 不是【Web 端(JS API)】那个。
#    申请: https://console.amap.com/  添加 Key 时"服务平台"选"Web 服务"
#    填错类型的症状: 工具能加载出来, 但每次查询都返回空/失败。
#    (前端地图用的那个 Key 填在 STEP5-前端练习/frontend/.env)
AMAP_API_KEY=your_amap_web_service_key_here

# ---------- 服务器配置 ----------
HOST=0.0.0.0
PORT=8200

# CORS: 允许哪些网页地址调用本后端。
# ⚠️ localhost 和 127.0.0.1 是两个不同的源, 建议四项都保留。
# 如果 Vite 因为 5173 被占而换了端口(比如 5174), 记得把新端口加进来。
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 日志级别
LOG_LEVEL=INFO

# ---------- Unsplash(可选) ----------
# 只用于结果页的景点配图, 不配也能跑完全部课程内容。
# 申请: https://unsplash.com/developers
# 注意: 只需要 Access Key。本项目代码从未读取 Secret Key, 不用填。
UNSPLASH_ACCESS_KEY=
