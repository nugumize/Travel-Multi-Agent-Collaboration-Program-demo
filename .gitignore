# ============================================================
# 教学包 · 忽略清单
# 这个文件的作用：防止把密钥和几百 MB 的依赖目录传到代码仓库里
# ============================================================

# 🔑 真实密钥，绝对不能提交（.env.example 是模板，要提交）
.env
.env.local
.env.*.local

# Python 虚拟环境和缓存
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 前端依赖和构建产物
node_modules/
dist/
dist-ssr/
*.local

# 日志
*.log
logs/
npm-debug.log*

# 编辑器 / 操作系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.sw?
